rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Admin identity ----------------------------------------------------
    function isFullAdmin() {
      return request.auth != null && (
        request.auth.uid == 'dPoj1JEQ57TSFYaniLPsB0rAjFu2'
        || request.auth.token.admin == true
      );
    }
    function isAdmin() {
      return isFullAdmin() || (request.auth != null
        && request.auth.uid == 'jB0005vbkwOQiqNQBrm2Ikk6u3B3');
    }
    // Outside freelance home-visit physiotherapist login (homevisit@w2w.in).
    // Deliberately NOT part of isAdmin() — this account gets client read/
    // update access (so it can find and add a home visit for ANY registered
    // patient, same as any other login — clients are shared across every
    // login), but never treatments/rehabPlans/fitnessPlans/accounting/the
    // clinic therapist list, and it may only ever CREATE a brand-new client
    // tagged Home-Visit-only (enforced on clients/{id} below).
    function isHomeVisitOnly() {
      return request.auth != null && request.auth.uid == 'PutvvFLabSY6n4SFJbmu01b4THv2';
    }

    // ---- Validation helpers (for public, unauthenticated writes) -----------
    function data() { return request.resource.data; }
    function optStr(f, max) {
      return !(f in data()) || (data()[f] is string && data()[f].size() <= max);
    }
    function reqStr(f, max) {
      return data()[f] is string && data()[f].size() > 0 && data()[f].size() <= max;
    }

    // Public can submit enquiries; only the admin can read/manage them.
    match /enquiries/{id} {
      allow create: if isAdmin() || (
        data().size() <= 8 && data().status == 'new'
        && reqStr('name', 120)
        && optStr('phone', 20) && optStr('email', 200)
        && optStr('service', 100) && optStr('message', 3000)
      );
      allow read, update, delete: if isAdmin();
    }

    // Public booking create (auto-confirm). Documents contain PII, so reads are
    // admin-only; public create is shape-validated to curb spam/abuse.
    match /appointments/{id} {
      allow create: if isAdmin() || (
        data().size() <= 11 && data().status == 'confirmed'
        && data().date is string && data().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data().time is string && data().time.matches('^[0-9]{2}:[0-9]{2}$')
        && reqStr('name', 120)
        && optStr('phone', 20) && optStr('email', 200)
        && optStr('service', 100) && optStr('notes', 2000) && optStr('source', 20)
      );
      allow read, update, delete: if isAdmin();
    }

    // Booked time strings only (no PII). Public read; public write constrained
    // to a single `times` list. Keep this to ONLY the `times` key — admin
    // "time off" blocks live in slotBlocks below, never in here, so public
    // booking writes always satisfy this rule.
    match /availability/{date} {
      allow read: if true;
      allow write: if isAdmin() || (
        data().keys().hasOnly(['times'])
        && data().times is list
        && data().times.size() <= 60
      );
    }

    // Admin "time off" — slots the clinic marked unavailable, per date
    // (slotBlocks/{date} = { times: [...] }). Public reads it to grey out slots;
    // only the admin writes it.
    match /slotBlocks/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Running counter for unique client IDs — admin only, plus the home-visit
    // login (it needs the same counter to auto-generate Reg. Nos).
    match /counters/{id} {
      allow read, write: if isAdmin() || isHomeVisitOnly();
    }

    // Client/patient CRM and all sub-data — admin only, EXCEPT the home-visit
    // login gets a narrow slice: it may read/update any client (clients are
    // shared across every login — it needs to find and add a home visit for
    // a patient registered by anyone), but a client it CREATES must be
    // Home-Visit-only, and it may never delete a client. Within any client,
    // only the homeVisits and notes subcollections are open to it —
    // treatments/rehabPlans/fitnessPlans and everything else stay admin-only.
    // homeVisitType field (if present) must be 'physio' or 'rehab' for Home Visit clients.
    match /clients/{id} {
      allow read: if isAdmin() || isHomeVisitOnly();
      // Which services a home-visit patient is registered for lives in its own
      // `homeVisitServices` list, NOT in `programs` — so `programs` stays
      // exactly ['W2W Home Visit'] and picking a service can never make a
      // home-visit patient look like a clinic one.
      allow create: if isAdmin() || (
        isHomeVisitOnly()
        && request.resource.data.programs is list
        && request.resource.data.programs == ['W2W Home Visit']
        && (!('homeVisitType' in request.resource.data) || request.resource.data.homeVisitType in ['physio', 'rehab', 'fitness'])
      );
      // The home-visit login may only edit a patient that already belongs to
      // Home Visits, and can never move them out of it.
      allow update: if isAdmin() || (
        isHomeVisitOnly()
        && 'W2W Home Visit' in resource.data.programs
        && 'W2W Home Visit' in request.resource.data.programs
        && (!('homeVisitType' in request.resource.data) || request.resource.data.homeVisitType in ['physio', 'rehab', 'fitness'])
      );
      allow delete: if isAdmin();

      match /homeVisits/{visitId} {
        allow read, write: if isAdmin() || isHomeVisitOnly();
      }
      match /notes/{noteId} {
        allow read, write: if isAdmin() || isHomeVisitOnly();
      }
      // The Home Visits module now runs the same Rehab & Exercises and
      // Fitness planners the clinic uses, so the home-visit login needs its
      // patients' exercise plans. Physio `treatments` stay clinic-only.
      match /rehabPlans/{planId} {
        allow read, write: if isAdmin() || isHomeVisitOnly();
      }
      match /fitnessPlans/{planId} {
        allow read, write: if isAdmin() || isHomeVisitOnly();
      }
      match /{sub=**} {
        allow read, write: if isAdmin();
      }
    }

    // Freelance home-visit therapist names — its own list, kept separate from
    // /therapists so freelancer names never surface in the clinic's Treatment/
    // Rehab/Fitness therapist picker (and vice versa). Any clinic admin can
    // still manage it; the home-visit login can too, but nothing wider.
    match /homeVisitTherapists/{id} { allow read, write: if isAdmin() || isHomeVisitOnly(); }

    // Invoices (Report & Invoices module) — financial documents, same
    // sensitivity tier as Accounting → full admin only.
    match /invoices/{id} { allow read, write: if isFullAdmin(); }
    // Invoice-only item/service list — kept separate from serviceCharges so
    // names/prices added here never surface in Accounting's or any other
    // module's service picker → full admin only (same as invoices).
    match /invoiceServices/{id} { allow read, write: if isFullAdmin(); }

    // Testimonials, blog & reels: public read; managed in the Blogs/content
    // module → full admin only.
    match /testimonials/{id} {
      allow read: if true;
      allow write: if isFullAdmin();
    }
    match /posts/{id} {
      allow read: if true;
      allow write: if isFullAdmin();
    }
    match /reels/{id} {
      allow read: if true;
      allow write: if isFullAdmin();
    }

    // Workshops: public read (to show open registrations); Workshop module is
    // full admin only.
    match /workshops/{id} {
      allow read: if true;
      allow write: if isFullAdmin();
    }

    // Public seat counter (no PII) — confirmed seats.
    match /workshopStats/{id} {
      allow read: if true;
      allow write: if isFullAdmin();
    }

    // Workshop registrations contain PII — public create (validated); only the
    // full admin reads/manages them.
    match /workshopRegistrations/{id} {
      allow create: if isFullAdmin() || (
        data().size() <= 14 && data().status == 'pending'
        && reqStr('fullName', 120)
        && optStr('phone', 20) && optStr('email', 200)
        && optStr('qualification', 60) && optStr('reason', 3000)
        && optStr('attendedBefore', 10) && optStr('paidVia', 60)
        && optStr('workshopId', 80) && optStr('workshopTitle', 200)
      );
      allow read, update, delete: if isFullAdmin();
    }

    // Email-uniqueness guard for workshop registrations.
    match /workshopRegEmails/{id} {
      allow create: if isFullAdmin() || data().size() == 0;
      allow read, update, delete: if isFullAdmin();
    }

    // Therapists — shared (Treatment module needs them) → any admin.
    match /therapists/{id} { allow read, write: if isAdmin(); }
    // Patient signatures (drawn in the Signatures module, shown on reports) → any admin.
    match /signatures/{id} { allow read, write: if isAdmin(); }
    // Accounting (patient charges) and expenses — Accounting module → full admin only.
    match /accounting/{id} { allow read, write: if isFullAdmin(); }
    match /expenses/{id} { allow read, write: if isFullAdmin(); }
    match /expenseCategories/{id} { allow read, write: if isFullAdmin(); }
    // Service charges (name + amount) for the Accounting charges dropdown.
    match /serviceCharges/{id} { allow read, write: if isFullAdmin(); }
    // Bank account names (Cash/Bank tagging in Expenses) — Accounting module → full admin only.
    match /bankAccounts/{id} { allow read, write: if isFullAdmin(); }
    // Reusable named exercise-set templates. The home-visit login builds plans
    // with the same planners, so it needs these too.
    match /rehabTemplates/{id} { allow read, write: if isAdmin() || isHomeVisitOnly(); }
    match /fitnessTemplates/{id} { allow read, write: if isAdmin() || isHomeVisitOnly(); }
    // Admin scratchpad notes/goals (Notes & Goals module) → full admin only.
    match /notes/{id} { allow read, write: if isFullAdmin(); }
  }
}
